# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave DATABASE_URL unset to use local SQLite (default for development).
# Example Postgres URL: postgres://user:password@localhost:5432/alzheimer_prediction
DATABASE_URL=

# --- CORS (only relevant once a separate frontend is added) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Media / uploads ---
MAX_UPLOAD_SIZE_MB=15

# --- ML / dataset paths ---
DATASET_ROOT=./dataset
ML_WEIGHTS_DIR=./ml/weights
DEVICE=auto
# auto = use CUDA if available, else CPU

# --- Model configuration ---
IMAGE_SIZE=224
CNN_BACKBONE=resnet50
SWIN_BACKBONE=swin_tiny_patch4_window7_224
FUSION_DIM=512
NUM_CLASSES=3

# --- Quality gate ---
MIN_QUALITY_SCORE=0.5

# --- Demo mode ---
DEMO_MODE=True
