# Sample MRI images: real dataset-derived files with an unconfirmed
# redistribution license are kept local-only; synthetic/non-redistributable
# images only would be safe to commit if added back deliberately.
/sample_mri_scans/*.jpg
/sample_mri_scans/*.jpeg
/sample_mri_scans/*.png

